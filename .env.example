# MongoDB Atlas connection string (server-side only; never expose to browser)
MONGODB_URI=

# Optional secret used to sign JWT session tokens (in-memory random secret used if unset in local dev)
AUTH_SECRET=

# Optional server-side administrator bootstrap passcode (if unset, use the first-run Admin Setup flow)
ADMIN_PASSCODE=

# Public application URL for deployment and links
APP_URL=http://localhost:3000
